        <mxCell id="9fADJIqU08Vi0cWy6jxG-17" value="&lt;p style=&quot;margin: 4px 0px 0px; text-align: center;&quot;&gt;&lt;b&gt;&lt;u&gt;scheduler&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Rôle : Planifier les tâches périodiques (acquisition, logging) à partir du tick Timer&lt;br&gt;&lt;/li&gt;&lt;li&gt;IN : Tick periodique (ISR Timer), configuration période&lt;/li&gt;&lt;li&gt;OUT : Compter les ticks, déclencher interruption aux bonnes périodes&lt;/li&gt;&lt;li&gt;API : Scheduler_Init(uint32_t period_ms), Scheduler_OnTick() // appelé depuis IT TIM3&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="160" y="565" width="240" height="200" as="geometry" />
